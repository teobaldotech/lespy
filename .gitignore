```dockerignore
# ============================================================
# Metadados e artefatos de pacotes Python
# ============================================================

# Metadados de distribuição
*.egg-info/
.eggs/
*.egg

# Pacotes compilados
*.whl

# Arquivos de catálogo de mensagens
*.pot

# Bytecode Python
*.py[cod]
*$py.class

# Cache e arquivos temporários
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Diretórios de build e distribuição
build/
dist/
wheels/
pip-wheel-metadata/
```
